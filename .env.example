# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway — used for Writing grading and (later) Whisper STT + Speaking grading
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://gateway.ai.vercel.app/v1
AI_GATEWAY_WRITING_MODEL=anthropic/claude-sonnet-4-6

# Set to "true" to bypass the AI Gateway and return a deterministic stub grade.
# Useful for local development without an AI Gateway key.
USE_STUB_GRADER=true

# Upstash (rate limiting) — optional, only required if you use the rate limiter
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (transactional email) — optional
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
