# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI examiner (Writing + Speaking marking). Any OpenAI-compatible endpoint works.
# Without AI_GATEWAY_API_KEY the app runs in demo mode: Writing/Speaking show
# clearly-labelled sample feedback; Reading/Listening are always really marked.
#
# Option A — Vercel AI Gateway (needs a card on the Vercel account):
#   AI_GATEWAY_API_KEY=<gateway key>
# Option B — OpenAI directly:
#   AI_GATEWAY_API_KEY=<openai key>
#   AI_GATEWAY_BASE_URL=https://api.openai.com/v1
#   AI_GATEWAY_WRITING_MODEL=gpt-4.1
#   AI_GATEWAY_SPEAKING_MODEL=gpt-4.1
#   AI_GATEWAY_STT_MODEL=whisper-1
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_WRITING_MODEL=anthropic/claude-sonnet-5.5

# Set to "true" to force demo mode even when a key is present.
USE_STUB_GRADER=

# Upstash (rate limiting) — optional, only required if you use the rate limiter
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (transactional email) — optional
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
